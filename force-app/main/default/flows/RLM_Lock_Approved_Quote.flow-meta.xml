<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Stamp_Approved</name>
        <label>Stamp Approved Snapshot</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <actionName>RLM_StampApprovedSnapshot</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>quoteId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>RLM_StampApprovedSnapshot</nameSegment>
    </actionCalls>
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Stamps approved net and discount when Status becomes Approved. Lock-on-Approved is speak-to only.</description>
    <environments>Default</environments>
    <interviewLabel>Stamp Approved Quote {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Stamp Approved Quote Snapshot</label>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Stamp_Approved</targetReference>
        </connector>
        <filterFormula>AND(ISPICKVAL({!$Record.Status}, "Approved"), ISCHANGED({!$Record.Status}))</filterFormula>
        <object>Quote</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
